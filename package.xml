<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waterlinkedsonar</name>
  <version>0.1.0</version>
  <description>C++ client library for the Water Linked Sonar 3D-15</description>

  <maintainer email="advay.pakhale@gmail.com">Advay Pakhale</maintainer>
  <license>MIT</license>

  <buildtool_depend>cmake</buildtool_depend>

  <depend>protobuf-dev</depend>
  <depend>libcurl4-openssl-dev</depend>
  <depend>libsnappy-dev</depend>
  <depend>zlib</depend>
  <depend>nlohmann-json-dev</depend>

  <test_depend>gtest</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
