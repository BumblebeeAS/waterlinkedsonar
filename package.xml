<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waterlinkedsonar</name>
  <version>0.1.0</version>
  <description>C++ client library for the Water Linked Sonar 3D-15</description>

  <maintainer email="advay.pakhale@gmail.com">Advay Pakhale</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/BumblebeeAS/waterlinkedsonar</url>
  <url type="bugtracker">https://github.com/BumblebeeAS/waterlinkedsonar/issues</url>
  <author email="advay.pakhale@gmail.com">Advay Pakhale</author>

  <buildtool_depend>cmake</buildtool_depend>

  <build_depend>nlohmann-json-dev</build_depend>
  <depend>libcurl-dev</depend>
  <depend>protobuf-dev</depend>
  <depend>snappy</depend>
  <depend>zlib</depend>

  <test_depend>gtest</test_depend>

  <doc_depend>doxygen</doc_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
